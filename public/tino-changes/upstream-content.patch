+    if args.rpc_token_prompt:
+        HEADERS["x-token"] = getpass.getpass("RPC x-token: ")
+    started = datetime.now(timezone.utc)
+
+    api_ids = {c["id"] for c in get_json(CONFIG_API)["data"]}
