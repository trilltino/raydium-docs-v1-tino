+        "slot": rpc("getSlot", []),
+        "amm_configs": {
+            "on_chain": len(configs),
+            "listed_by_cpmm_config_api": sum(c["in_cpmm_config_api"] for c in configs),
+            "unlisted_indexes": [c["index"] for c in configs if not c["in_cpmm_config_api"]],
