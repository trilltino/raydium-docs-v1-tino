+This read-only example targets `@raydium-io/raydium-sdk-v2@0.2.64-alpha` on Solana mainnet-beta. Last verified against that release's source on 2026-10-14. The SDK selects the farm program from each position; see [program addresses](/reference/program-addresses#on-chain-programs).
+
+```ts
+// SDK: @raydium-io/raydium-sdk-v2@0.2.64-alpha
+// Cluster: mainnet-beta; farm programs: see reference/program-addresses
+// Last verified: 2026-10-14, source inspection
+import { Connection, PublicKey } from "@solana/web3.js";
+import { Raydium } from "@raydium-io/raydium-sdk-v2";
+import { Decimal } from "decimal.js";
+
+// Set RPC_URL and OWNER_ADDRESS to your RPC endpoint and wallet public key.
+const raydium = await Raydium.load({
+  connection: new Connection(process.env.RPC_URL!, "confirmed"),
+  owner: new PublicKey(process.env.OWNER_ADDRESS!),
+  cluster: "mainnet",
+  disableFeatureCheck: true,
+  disableLoadToken: true,
+});
+
+const farms = await raydium.farm.fetchFarmBalances();
+for (const farm of farms) {
+  for (const reward of farm.pendingRewards) {
+    const uiAmount = new Decimal(reward.amount)
+      .div(new Decimal(10).pow(reward.mint.decimals))
+      .toFixed();
+    console.log(farm.farmInfo.id, reward.mint.address, uiAmount);
+  }
+}
+```
+
+`pendingRewards[].mint` contains token metadata, including the mint address and decimals. `amount` is an integer string in the reward token's smallest units. Use decimal arithmetic to format it without losing precision.
+
+`fetchFarmBalances()` reads stored reward-per-share values and subtracts the user's reward debt. In this release, it does not advance those values for elapsed time. Treat the result as a calculation from stored account state, rather than a guarantee of rewards accrued through the current instant. It also depends on cached Owner API discovery, so recent stakes may not appear immediately.
+
