# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Internal architecture document — for contributors only, not user-facing.
# Root-anchored so the pattern doesn't accidentally match
# `docs/en/protocol-overview/architecture.mdx` on case-insensitive filesystems (macOS APFS).
/ARCHITECTURE.mdx
/docs/i18n/zh/ARCHITECTURE.mdx

# Draft content
drafts/
*.draft.mdx

# Static assets served via GitHub Pages (not by Mintlify). Contains files
# Mintlify cannot host directly, e.g. the MiCAR white paper .xhtml / .pdf.
# Published from public/ by .github/workflows/pages.yml.
public/

# Local research checkouts are not part of the Mintlify site.
/research/
/research/**
research/
research/**
**/research/**
**/tsconfig*.json

# Local deep-research notes and generated reports are not part of the site.
/research_notes/
/reports/

# Contributor guidance, not site content (CONTRIBUTING.md is ignored automatically).
/CONTRIBUTION_STANDARDS.md

# Prompts and research briefs, not site content.
/prompts/
